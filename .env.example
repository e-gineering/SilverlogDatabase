# Copy this file to .env and fill in real values.
# .env is git-ignored and should never be committed.

POSTGRES_USER=silverlog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=silverlog
POSTGRES_PORT=5432

# Used by dbmate to connect and run migrations against local Postgres
DATABASE_URL=postgres://silverlog:changeme@localhost:5432/silverlog?sslmode=disable

# To run migrations against Neon instead of local Postgres (e.g. for a Render
# deploy), comment out the line above and use Neon's own connection string
# here instead -- copy it from the Neon console's Connect button. sslmode=require
# is mandatory for Neon's external connections; the "-pooler" host is optional
# (use it if you're running lots of short-lived connections, doesn't matter
# for a one-off `dbmate up`). See database-SETUP_NOTES.md's Neon section.
# DATABASE_URL="postgresql://<user>:<password>@<your-project>.neon.tech/<dbname>?sslmode=require"
